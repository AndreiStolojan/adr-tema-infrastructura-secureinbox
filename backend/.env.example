# Copy this file to .env.development.local for local development.
PORT=5500
NODE_ENV=development
DB_URI=mongodb://127.0.0.1:27017/secureinbox_demo
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=8h
FRONTEND_APP_URL=http://localhost:5173

# Used only by `npm run seed`. These credentials are fictitious.
DEMO_USER_NAME=Demo User
DEMO_USER_EMAIL=demo@secureinbox.test
DEMO_USER_PASSWORD=Demo123!
